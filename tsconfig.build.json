{
    // Declaration-emit config for the published entry (`tsc -p tsconfig.build.json`,
    // run by `npm run build` after `vite build`). Mirrors the harness convention
    // (packages/underload/harness/tsconfig.build.json): JS comes from Vite lib
    // mode, .d.ts comes from tsc.
    //
    // Emit map (rootDir src -> outDir dist; the tree mirrors the src/ layers):
    //   src/dashboard.ts     -> dist/dashboard.d.ts         (package.json "types" / exports.types)
    //   src/<layer>/index.ts -> dist/<layer>/index.d.ts     (layer barrels: core, extensions, plugin, types)
    //   src/<layer>/<m>.ts   -> dist/<layer>/<m>.d.ts       (internal, reachable from the entry)
    // Tests never reach dist because `**/*.test.ts` is excluded below, which is
    // also why they live in src/tests/ rather than beside the entry.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "emitDeclarationOnly": true,
        "declaration": true,
        "rootDir": "src",
        "outDir": "dist"
    },
    "exclude": [
        "node_modules",
        "dist",
        "lib",
        "coverage",
        "example",
        "Temp",
        "**/*.test.ts",
        "**/*.test.tsx",
        // Root configs are typechecked (tsconfig.json) but never published, so
        // no declaration is emitted for them.
        "vite.config.ts",
        "vitest.config.ts"
    ],
    // Only the published source tree is described: example/** and the root
    // configs stay out of dist/**.
    "include": ["src/**/*"]
}

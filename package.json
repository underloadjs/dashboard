{
    "name": "@underload/dashboard",
    "version": "1.0.2",
    "description": "Headless plugin-composed dashboard core for the underload service ecosystem",
    "type": "module",
    "main": "./src/dashboard.ts",
    "module": "./src/dashboard.ts",
    "types": "./src/dashboard.ts",
    "exports": {
        ".": {
            "types": "./dist/dashboard.d.ts",
            "development": "./src/dashboard.ts",
            "import": "./dist/underload-dashboard.mjs",
            "default": "./dist/underload-dashboard.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.spec.ts",
        "!src/**/*.spec.tsx",
        "!src/**/__snapshots__/**",
        "!src/**/node_modules/**"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/underloadjs/dashboard.git"
    },
    "homepage": "https://github.com/underloadjs/dashboard#readme",
    "bugs": {
        "url": "https://github.com/underloadjs/dashboard/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json && node scripts/fix-declaration-specifiers.mjs",
        "build:types": "tsc -p tsconfig.build.json && node scripts/fix-declaration-specifiers.mjs",
        "example:dev": "vite --config example/vite.config.ts",
        "example:build": "vite build --config example/vite.config.ts",
        "example:preview": "vite preview --config example/vite.config.ts",
        "test": "vitest run",
        "test:example": "vitest run --config example/vitest.config.ts",
        "test:package": "node scripts/check-package.mjs",
        "test:package:scripts": "node --test scripts/fix-declaration-specifiers.test.mjs",
        "prepublishOnly": "npm run typecheck && npm run test && npm run test:package:scripts && npm run build && npm run test:package",
        "typecheck": "tsc --noEmit && tsc --noEmit -p example/tsconfig.json",
        "release": "vite-node ../../../scripts/publish-safe.ts"
    },
    "author": "NQQT",
    "license": "ISC",
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.9.1",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "jsdom": "^29.0.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "typescript": "^6.0.0",
        "vite": "^8.0.8",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.4"
    }
}

{
    // Self-contained config (no `extends` outside the repo): this package is a
    // standalone GitHub repo (git@github.com:underloadjs/dashboard) where
    // ../../../tsconfig.json does not exist. Options mirror the noobscript
    // workspace root tsconfig.json so behavior is identical when the package is
    // developed inside the workspace (same approach as packages/underload/bench
    // and packages/underload/harness).
    "compilerOptions": {
        "module": "ESNext",
        "target": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react",
        "skipLibCheck": true,
        "allowJs": true,
        "experimentalDecorators": true,
        "declaration": true,
        "esModuleInterop": true,
        "strict": true,
        "outDir": "./lib",
        "lib": ["decorators", "dom", "es5", "scripthost", "es2015.collection"],
        "types": ["node", "vitest/globals"]
    },
    "exclude": ["node_modules", "Temp", "**/*.test.ts", "**/dist/*", "**/lib/*"],
    // All source lives under src/; config files at the package root (this file
    // and vitest.config.ts) are typechecked too.
    "include": ["src/**/*", "*.ts", "*.tsx"]
}

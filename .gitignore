# Dependencies (installed fresh per checkout: no lockfile is committed, so CI
# runs `npm install`; see .github/workflows/deploy-pages.yml).
node_modules/

# Build outputs. The library itself emits nothing (it publishes TypeScript source,
# and every export condition resolves into `src/`), so:
#   dist/          LEFTOVER from the retired library bundle — kept ignored so a
#                  stale tree is never committed or packed
#   lib/           stray tsc emit
#   example/dist/  static example site (`npm run example:build`, GitHub Pages)
dist/
lib/
example/dist/

# Test/Vite caches and coverage.
coverage/
.vite/
example/.vite/

# Turborepo task cache/logs.
.turbo/

# Scratch space for local agent/tooling probes (repo-root policy: Temp/, never OS temp).
Temp/

# Incremental tsc state.
*.tsbuildinfo
